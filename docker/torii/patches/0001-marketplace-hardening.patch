+            "::1",
+            "fc00::1",
+            "fe80::1",
+            "2001:db8::1",
+            "::ffff:127.0.0.1",
+            "::ffff:169.254.169.254",
+            "64:ff9b::7f00:1",
+            "64:ff9b:1::1",
+            "100::1",
+            "2001::1",
+            "2002:7f00:1::",
+            "fec0::1",
+        ] {
+            assert!(forbidden_ip(ip.parse().unwrap()), "{ip} must be rejected");
         }
+        assert!(!forbidden_ip("1.1.1.1".parse().unwrap()));
+        assert!(!forbidden_ip("2606:4700:4700::1111".parse().unwrap()));
+    }
+
+    #[test]
+    fn enforces_mime_policy_and_body_limits() {
+        assert!(validate_mime(ContentKind::Json, Some("application/json")).is_ok());
+        assert!(validate_mime(ContentKind::Json, Some("application/ld+json")).is_ok());
+        assert!(validate_mime(ContentKind::Json, Some("text/plain; charset=utf-8")).is_ok());
+        assert!(validate_mime(ContentKind::Json, Some("text/html")).is_err());
+        assert!(validate_mime(ContentKind::Image, Some("image/svg+xml")).is_ok());
+        assert!(validate_mime(ContentKind::Image, Some("image/bmp")).is_err());
+        assert!(validate_tolerated_json_mime("text/plain", br#"{"ok":true}"#).is_ok());
+        assert!(validate_tolerated_json_mime("application/octet-stream", b"not-json").is_err());
+        assert!(validate_data_uri_size(&vec![0; DATA_URI_LIMIT + 1], ContentKind::Json).is_err());
+    }
+
+    #[test]
+    fn sanitizes_scripts_handlers_styles_and_remote_embeds_from_svg() {
+        let input = br#"<svg xmlns="http://www.w3.org/2000/svg" onload="alert(1)">
+          <script>alert(1)</script><style>*{background:url(https://evil)}</style>
+          <image href="https://evil.example/pixel.png" style="display:block"/>
+          <image href="data:image/png;base64,AA=="/>
+          <foreignObject><iframe src="https://evil.example"/></foreignObject>
+        </svg>"#;
+        let output = String::from_utf8(sanitize_svg(input).unwrap()).unwrap();
+        assert!(!output.contains("script"));
+        assert!(!output.contains("foreignObject"));
+        assert!(!output.contains("onload"));
+        assert!(!output.contains("https://evil"));
+        assert!(output.contains("data:image/png;base64,AA=="));
+    }
+
+    #[tokio::test]
+    async fn rejects_unsafe_ipfs_paths_and_url_credentials() {
+        assert!(ipfs_gateway_url("../metadata.json").is_err());
+        assert!(ipfs_gateway_url("QmValid/metadata.json").is_ok());
+        let url = Url::parse("https://user:pass@example.com/metadata").unwrap();
+        assert!(matches!(
+            resolve_and_validate(&url, Instant::now() + REQUEST_TIMEOUT).await,
+            Err(HttpError::Policy(_))
+        ));
+    }
+
+    #[tokio::test]
+    async fn rejects_direct_and_redirected_private_targets_before_connecting() {
+        let direct = Url::parse("http://169.254.169.254/latest/meta-data").unwrap();
+        assert!(matches!(
+            resolve_and_validate(&direct, Instant::now() + REQUEST_TIMEOUT).await,
+            Err(HttpError::Policy(_))
+        ));
+
+        let public = Url::parse("https://example.com/metadata.json").unwrap();
+        let redirected = redirect_target(&public, "http://127.0.0.1/secret", 0).unwrap();
+        assert!(matches!(
+            resolve_and_validate(&redirected, Instant::now() + REQUEST_TIMEOUT).await,
+            Err(HttpError::Policy(_))
+        ));
+    }
+
+    #[test]
+    fn rejects_dns_rebinding_sets_and_redirect_loops() {
+        let mixed = [
+            "1.1.1.1:443".parse::<SocketAddr>().unwrap(),
+            "10.0.0.1:443".parse::<SocketAddr>().unwrap(),
+        ];
+        assert!(validate_resolved_addresses("rebind.example", &mixed).is_err());
+
+        let current = Url::parse("https://example.com/a").unwrap();
+        assert!(redirect_target(&current, "/b", MAX_REDIRECTS).is_err());
+    }
+
+    #[test]
+    fn retries_only_rate_limits_and_server_failures() {
+        assert!(transient_status(StatusCode::TOO_MANY_REQUESTS));
+        assert!(transient_status(StatusCode::BAD_GATEWAY));
+        assert!(!transient_status(StatusCode::REQUEST_TIMEOUT));
+        assert!(!transient_status(StatusCode::BAD_REQUEST));
     }
 }
