+fn ipfs_gateway_url(cid: &str) -> Result<String, HttpError> {
+    if cid.is_empty()
+        || cid.len() > 512
+        || cid.contains("..")
+        || cid.split('/').any(|part| {
+            part.is_empty()
+                || !part
+                    .chars()
+                    .all(|ch| ch.is_ascii_alphanumeric() || ch == '-' || ch == '_' || ch == '.')
+        })
+    {
+        return Err(HttpError::Policy("invalid IPFS CID/path".to_string()));
+    }
+    let gateway =
+        std::env::var("TORII_IPFS_GATEWAY").unwrap_or_else(|_| "https://ipfs.io/ipfs/".to_string());
+    let gateway = gateway.trim_end_matches('/');
+    Ok(format!("{gateway}/{cid}"))
+}
