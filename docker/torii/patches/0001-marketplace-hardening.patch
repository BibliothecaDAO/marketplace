+fn validate_scheme(url: &Url) -> Result<(), HttpError> {
+    match url.scheme() {
+        "http" | "https" => Ok(()),
+        scheme => Err(HttpError::Policy(format!(
+            "unsupported URL scheme {scheme}"
+        ))),
+    }
+}
+
+async fn resolve_and_validate(
+    url: &Url,
+    deadline: Instant,
+) -> Result<(String, Vec<SocketAddr>), HttpError> {
+    validate_scheme(url)?;
+    if !url.username().is_empty() || url.password().is_some() {
+        return Err(HttpError::Policy(
+            "URLs containing credentials are not allowed".to_string(),
+        ));
+    }
+    let host = url
+        .host_str()
+        .ok_or_else(|| HttpError::Policy("URL is missing a host".to_string()))?
+        .to_string();
+    let port = url
+        .port_or_known_default()
+        .ok_or_else(|| HttpError::Policy("URL is missing a usable port".to_string()))?;
+    let addresses: Vec<SocketAddr> = match host.parse::<IpAddr>() {
+        Ok(ip) => vec![SocketAddr::new(ip, port)],
+        Err(_) => tokio::time::timeout_at(deadline, lookup_host((host.as_str(), port)))
+            .await
+            .map_err(|_| HttpError::Timeout)??
+            .collect(),
+    };
+    validate_resolved_addresses(&host, &addresses)?;
+    Ok((host, addresses))
+}
+
+fn validate_resolved_addresses(host: &str, addresses: &[SocketAddr]) -> Result<(), HttpError> {
+    if addresses.is_empty() {
+        return Err(HttpError::Policy("host did not resolve".to_string()));
+    }
+    if addresses.iter().any(|address| forbidden_ip(address.ip())) {
+        return Err(HttpError::Policy(format!(
+            "host {host} resolved to a non-public address"
+        )));
+    }
+    Ok(())
+}
+
+fn redirect_target(current: &Url, location: &str, redirects: usize) -> Result<Url, HttpError> {
+    if redirects >= MAX_REDIRECTS {
+        return Err(HttpError::Policy("redirect limit exceeded".to_string()));
+    }
+    current
+        .join(location)
+        .map_err(|error| HttpError::Policy(format!("invalid redirect: {error}")))
+}
+
+fn validate_mime(kind: ContentKind, mime: Option<&str>) -> Result<(), HttpError> {
+    let mime = mime
+        .and_then(|value| value.split(';').next())
+        .map(str::trim)
+        .unwrap_or("")
+        .to_ascii_lowercase();
+    let accepted = match kind {
+        ContentKind::Json => {
+            mime == "application/json"
+                || mime.ends_with("+json")
+                || mime == "text/plain"
+                || mime == "application/octet-stream"
         }
+        ContentKind::Image => matches!(
+            mime.as_str(),
+            "image/png" | "image/jpeg" | "image/webp" | "image/gif" | "image/svg+xml"
+        ),
+    };
+    if !accepted {
+        return Err(HttpError::InvalidMimeType(if mime.is_empty() {
+            "missing".to_string()
+        } else {
+            mime
+        }));
     }
+    Ok(())
 }
+
+fn normalized_mime(mime: Option<&str>) -> String {
+    mime.and_then(|value| value.split(';').next())
+        .map(str::trim)
+        .unwrap_or("")
+        .to_ascii_lowercase()
+}
+
+fn validate_tolerated_json_mime(mime: &str, body: &[u8]) -> Result<(), HttpError> {
+    if !matches!(mime, "text/plain" | "application/octet-stream") {
+        return Ok(());
+    }
+    serde_json::from_slice::<serde_json::Value>(body).map_err(|_| {
+        HttpError::InvalidMimeType(format!(
+            "{mime} is accepted only when the response body is valid JSON"
+        ))
+    })?;
+    warn!(content_type = %mime, "Tolerating non-JSON metadata MIME after parse validation");
+    Ok(())
+}

