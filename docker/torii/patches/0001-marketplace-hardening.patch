+pub fn validate_data_uri_size(bytes: &[u8], kind: ContentKind) -> Result<(), HttpError> {
+    let limit = match kind {
+        ContentKind::Json => DATA_URI_LIMIT,
+        ContentKind::Image => IMAGE_BODY_LIMIT,
+    };
+    if bytes.len() > limit {
+        return Err(HttpError::BodyTooLarge(limit));
+    }
+    Ok(())
+}
+
+fn sanitize_svg_element(element: &mut Element) {
+    element.attributes.retain(|name, value| {
+        let name = name.to_ascii_lowercase();
+        if name.starts_with("on") || name == "style" {
+            return false;
+        }
+        if name == "href" || name.ends_with(":href") {
+            return value.starts_with('#')
+                || value.starts_with("data:image/png;base64,")
+                || value.starts_with("data:image/jpeg;base64,")
+                || value.starts_with("data:image/webp;base64,")
+                || value.starts_with("data:image/gif;base64,");
+        }
+        true
+    });
+    element.children.retain(|child| match child {
+        XMLNode::Element(child) => !matches!(
+            child.name.to_ascii_lowercase().as_str(),
+            "script" | "style" | "foreignobject" | "iframe" | "object" | "embed"
+        ),
+        XMLNode::ProcessingInstruction(..) => false,
+        _ => true,
+    });
+    for child in &mut element.children {
+        if let XMLNode::Element(child) = child {
+            sanitize_svg_element(child);
+        }
+    }
+}
+
+pub fn sanitize_svg(svg: &[u8]) -> Result<Vec<u8>, HttpError> {
+    if svg.len() > IMAGE_BODY_LIMIT {
+        return Err(HttpError::BodyTooLarge(IMAGE_BODY_LIMIT));
+    }
+    let mut root = Element::parse(Cursor::new(svg))
+        .map_err(|error| HttpError::Policy(format!("invalid SVG XML: {error}")))?;
+    if !root.name.eq_ignore_ascii_case("svg") {
+        return Err(HttpError::Policy(
+            "image is not an SVG document".to_string(),
+        ));
+    }
+    sanitize_svg_element(&mut root);
+    let mut output = Vec::new();
+    root.write(&mut output)
+        .map_err(|error| HttpError::Policy(format!("failed to serialize SVG: {error}")))?;
+    Ok(output)
+}
